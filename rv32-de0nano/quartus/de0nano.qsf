## EPCS -- the four active-serial configuration pins to the on-board EPCS device (not in the
## manual's pin tables; from the Terasic golden .qsf). They are usable as regular I/O only
## together with the five dual-purpose settings below (the CYCLONEII_ prefix is legacy naming
## that Quartus still honours for Cyclone IV). Enable the whole block or none of it: freeing
## these on a board that boots from EPCS forfeits normal EPCS access. This design does not use
## them; they are listed only to account for the device's remaining 4 of 154 I/O.
#set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
#set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
#set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
#set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
#set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"
#set_location_assignment PIN_H2  -to EPCS_DATA0
#set_location_assignment PIN_H1  -to EPCS_DCLK
#set_location_assignment PIN_D2  -to EPCS_NCSO
#set_location_assignment PIN_C1  -to EPCS_ASDO
