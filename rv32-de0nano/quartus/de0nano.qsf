## 2x13 header (JP3) -- 16 FPGA balls, listed in signal order (the JP3 connector-pin numbering
## was not transcribed from a machine-readable source, so no connector-pin notes here). JP3 also
## carries Analog_In[7:0], which go to the ADC128S022 (see the ADC section) and not to the FPGA.
#set_location_assignment PIN_E15 -to GPIO_2_IN[0]
#set_location_assignment PIN_E16 -to GPIO_2_IN[1]
#set_location_assignment PIN_M16 -to GPIO_2_IN[2]
