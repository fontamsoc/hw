## Created from: the DE0-Nano User Manual pin-assignment tables (Tables 3-1..3-10),
## cross-checked against the Terasic golden top-level DE0_Nano.qsf and board schematic sheet 09.
## CAUTION: Quartus treats a location assignment to a non-existent node as a warning, not an
## error -- a typo in a live line silently lets the fitter auto-place that port. When
## uncommenting a pin, keep the assignment line bare: move its trailing "# JP1-nn" note to its
## own line above. Quartus GUI project saves rewrite this file and strip comments -- edit it
## with a text editor.

## Core Device Properties
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY de0nano
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

## Thermal & Operating Constraints
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

## Design Files & Language Settings
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
#set_global_assignment -name VERILOG_CONSTANT_LOOP_LIMIT 70000
set_global_assignment -name SYSTEMVERILOG_FILE ../de0nano.sv
set_global_assignment -name SDC_FILE ../de0nano.sdc
set_global_assignment -name SEARCH_PATH ".."
set_global_assignment -name SEARCH_PATH "../.."
set_global_assignment -name SEARCH_PATH "../../cpu"

## Every user I/O bank on the DE0-Nano is powered at 3.3 V, so state it once here rather than on
## each of the 150 pin lines below. Anything uncommented later inherits it automatically. Without
## it Quartus falls back to the Cyclone IV E default of 2.5 V, which mis-models the bank VCCIO
## and gives wrong input thresholds on clk50mhz_i / rst_n / uart_rx.
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

## The Quartus default for every pin left commented out below is "as output driving ground",
## which would actively drive the GPIO header pins, the JP3 pins, the I2C bus and
## DRAM_CS_N/RAS_N/CAS_N/WE_N -- with a USB-serial dongle seated on JP1, one miswire is a
## direct output-to-output short. Tri-state them with a weak pull-up instead; that is also the
## safe idle state for the SDRAM control lines and ADC_CS_N. (Deliberate divergence from the
## Terasic golden .qsf, which leaves this at the default because it uses all 154 pins.)
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"

set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

## Clock
## CLOCK_50 -- 50 MHz on-board oscillator, dedicated clock input -> top-level clk50mhz_i
set_location_assignment PIN_R8  -to clk50mhz_i

## Push-buttons (KEY) -- active low, hardware debounced on the board
## KEY[0] -- active-low reset -> top-level rst_n (further debounced by lib/rstctrl.sv)
set_location_assignment PIN_J15 -to rst_n
#set_location_assignment PIN_E1  -to KEY[1]

## LEDs -- 8 green LEDs, lit by driving the pin high
set_location_assignment PIN_A15 -to led_o[0]
set_location_assignment PIN_A13 -to led_o[1]
set_location_assignment PIN_B13 -to led_o[2]
set_location_assignment PIN_A11 -to led_o[3]
set_location_assignment PIN_D1  -to led_o[4]
set_location_assignment PIN_F3  -to led_o[5]
set_location_assignment PIN_B1  -to led_o[6]
set_location_assignment PIN_L3  -to led_o[7]

## DIP switches (SW) -- 4-position DIP
#set_location_assignment PIN_M1  -to SW[0]
#set_location_assignment PIN_T8  -to SW[1]
#set_location_assignment PIN_B9  -to SW[2]
#set_location_assignment PIN_M15 -to SW[3]

## SDRAM -- 32 MB, 16-bit data bus. The golden .qsf calls these ports
## DRAM_ADDR/BA/DQ/DQM/RAS_N/CAS_N/CKE/CLK/WE_N/CS_N in the same ball order.
set_location_assignment PIN_P2  -to sdram_addr_o[0]
set_location_assignment PIN_N5  -to sdram_addr_o[1]
set_location_assignment PIN_N6  -to sdram_addr_o[2]
set_location_assignment PIN_M8  -to sdram_addr_o[3]
set_location_assignment PIN_P8  -to sdram_addr_o[4]
set_location_assignment PIN_T7  -to sdram_addr_o[5]
set_location_assignment PIN_N8  -to sdram_addr_o[6]
set_location_assignment PIN_T6  -to sdram_addr_o[7]
set_location_assignment PIN_R1  -to sdram_addr_o[8]
set_location_assignment PIN_P1  -to sdram_addr_o[9]
set_location_assignment PIN_N2  -to sdram_addr_o[10]
set_location_assignment PIN_N1  -to sdram_addr_o[11]
set_location_assignment PIN_L4  -to sdram_addr_o[12]
set_location_assignment PIN_M7  -to sdram_ba_o[0]
set_location_assignment PIN_M6  -to sdram_ba_o[1]
set_location_assignment PIN_G2  -to sdram_data_io[0]
set_location_assignment PIN_G1  -to sdram_data_io[1]
set_location_assignment PIN_L8  -to sdram_data_io[2]
set_location_assignment PIN_K5  -to sdram_data_io[3]
set_location_assignment PIN_K2  -to sdram_data_io[4]
set_location_assignment PIN_J2  -to sdram_data_io[5]
set_location_assignment PIN_J1  -to sdram_data_io[6]
set_location_assignment PIN_R7  -to sdram_data_io[7]
set_location_assignment PIN_T4  -to sdram_data_io[8]
set_location_assignment PIN_T2  -to sdram_data_io[9]
set_location_assignment PIN_T3  -to sdram_data_io[10]
set_location_assignment PIN_R3  -to sdram_data_io[11]
set_location_assignment PIN_R5  -to sdram_data_io[12]
set_location_assignment PIN_P3  -to sdram_data_io[13]
set_location_assignment PIN_N3  -to sdram_data_io[14]
set_location_assignment PIN_K1  -to sdram_data_io[15]
set_location_assignment PIN_R6  -to sdram_dqm_o[0]
set_location_assignment PIN_T5  -to sdram_dqm_o[1]
set_location_assignment PIN_L2  -to sdram_ras_o
set_location_assignment PIN_L1  -to sdram_cas_o
set_location_assignment PIN_L7  -to sdram_cke_o
set_location_assignment PIN_R4  -to sdram_clk_o
set_location_assignment PIN_C2  -to sdram_we_o
set_location_assignment PIN_P6  -to sdram_cs_o

## I2C serial EEPROM / G-sensor (ADXL345)
## The manual lists I2C_SCLK/I2C_SDAT under both the EEPROM and the G-sensor tables; they are the
## same two balls, listed once here. G_SENSOR_CS_N must be driven high to keep the ADXL345 in I2C
## mode; left unused it is held high by the weak pull-up policy above.
#set_location_assignment PIN_F2  -to I2C_SCLK
#set_location_assignment PIN_F1  -to I2C_SDAT
#set_location_assignment PIN_G5  -to G_SENSOR_CS_N
#set_location_assignment PIN_M2  -to G_SENSOR_INT

## ADC -- ADC128S022, 8-channel 12-bit SPI. Its analog inputs arrive on the 2x13 header (JP3),
## not on FPGA balls.
#set_location_assignment PIN_A10 -to ADC_CS_N
#set_location_assignment PIN_B10 -to ADC_SADDR
#set_location_assignment PIN_A9  -to ADC_SDAT
#set_location_assignment PIN_B14 -to ADC_SCLK

## GPIO-0 (JP1) -- 2x20 header, listed in connector-pin order (odd row 1,3..39 / even row
## 2,4..40), which is how the golden .qsf lists it and how you walk it on the physical board.
## JP1-11 = VCC_SYS (+5 V), JP1-12 = GND, JP1-29 = VCC3P3 (+3.3 V), JP1-30 = GND -- board power,
## no FPGA ball; the other 36 pins go straight to the Cyclone IV.
##
## MOVING THE UART -- the pair below is a candidate, not a board-defined UART: the DE0-Nano has
## no USB-UART bridge, and JP1-13/14 were chosen because they are the two pins next to the
## JP1-12 ground. To relocate, move the ball onto the target pin's line and re-comment the line
## you took it from, so every ball still appears exactly once in this file.
## RX/TX ARE CROSSED AT THE DONGLE -- uart_rx (an FPGA input) goes to the dongle's TX.
## 3.3 V ONLY -- DE0-Nano GPIO pins are NOT 5 V tolerant; a 5 V FTDI-style cable will damage the
## FPGA. Use a 3.3 V dongle and share the JP1-12 ground.
#set_location_assignment PIN_A8  -to GPIO_0_IN[0]  # JP1-1
#set_location_assignment PIN_D3  -to GPIO_0[0]     # JP1-2
#set_location_assignment PIN_B8  -to GPIO_0_IN[1]  # JP1-3
#set_location_assignment PIN_C3  -to GPIO_0[1]     # JP1-4
#set_location_assignment PIN_A2  -to GPIO_0[2]     # JP1-5
#set_location_assignment PIN_A3  -to GPIO_0[3]     # JP1-6
#set_location_assignment PIN_B3  -to GPIO_0[4]     # JP1-7
#set_location_assignment PIN_B4  -to GPIO_0[5]     # JP1-8
#set_location_assignment PIN_A4  -to GPIO_0[6]     # JP1-9
#set_location_assignment PIN_B5  -to GPIO_0[7]     # JP1-10
#                                                  # JP1-11 = VCC_SYS (+5 V)
#                                                  # JP1-12 = GND
## GPIO_0[8] / JP1-13 -- 115200 8N1 serial in (dev/serial_uart.sv) -> top-level uart_rx
set_location_assignment PIN_A5  -to uart_rx
## Idle the line high so an unplugged dongle cannot float noise into the receiver
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to uart_rx
## GPIO_0[9] / JP1-14 -- 115200 8N1 serial out (dev/serial_uart.sv) <- top-level uart_tx
set_location_assignment PIN_D5  -to uart_tx
#set_location_assignment PIN_B6  -to GPIO_0[10]    # JP1-15
#set_location_assignment PIN_A6  -to GPIO_0[11]    # JP1-16
#set_location_assignment PIN_B7  -to GPIO_0[12]    # JP1-17
#set_location_assignment PIN_D6  -to GPIO_0[13]    # JP1-18
#set_location_assignment PIN_A7  -to GPIO_0[14]    # JP1-19
#set_location_assignment PIN_C6  -to GPIO_0[15]    # JP1-20
#set_location_assignment PIN_C8  -to GPIO_0[16]    # JP1-21
#set_location_assignment PIN_E6  -to GPIO_0[17]    # JP1-22
#set_location_assignment PIN_E7  -to GPIO_0[18]    # JP1-23
#set_location_assignment PIN_D8  -to GPIO_0[19]    # JP1-24
#set_location_assignment PIN_E8  -to GPIO_0[20]    # JP1-25
#set_location_assignment PIN_F8  -to GPIO_0[21]    # JP1-26
#set_location_assignment PIN_F9  -to GPIO_0[22]    # JP1-27
#set_location_assignment PIN_E9  -to GPIO_0[23]    # JP1-28
#                                                  # JP1-29 = VCC3P3 (+3.3 V)
#                                                  # JP1-30 = GND
#set_location_assignment PIN_C9  -to GPIO_0[24]    # JP1-31
#set_location_assignment PIN_D9  -to GPIO_0[25]    # JP1-32
#set_location_assignment PIN_E11 -to GPIO_0[26]    # JP1-33
#set_location_assignment PIN_E10 -to GPIO_0[27]    # JP1-34
#set_location_assignment PIN_C11 -to GPIO_0[28]    # JP1-35
#set_location_assignment PIN_B11 -to GPIO_0[29]    # JP1-36
#set_location_assignment PIN_A12 -to GPIO_0[30]    # JP1-37
#set_location_assignment PIN_D11 -to GPIO_0[31]    # JP1-38
#set_location_assignment PIN_D12 -to GPIO_0[32]    # JP1-39
