# Merged over linux.config for the kernel of several harts (package
# linux-smp): the bitstream built with CPU_COUNT=2 and ATOMIC_COHERENCE=1,
# the secondary harts woken from bootldr by an interprocessor interrupt.
# The spinlocks are ticket spinlocks, the only choice without MMU.
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_RISCV_BOOT_SPINWAIT=y
# CONFIG_HOTPLUG_CPU is not set
