diff --git a/drivers/clocksource/timer-ftpu.c b/drivers/clocksource/timer-ftpu.c
new file mode 100644
index 000000000..5aa61e4bc
--- /dev/null
+++ b/drivers/clocksource/timer-ftpu.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// 20261120 (c) William Fonkou Tambe
+/*
+ * The timer of the FonTamSOC ftpu RISC-V core. In M-mode, its CSR time counts
+ * every clock cycle, the same on every hart, at riscv_timebase, which
+ * time_init() reads from its CSR clkfreq; each hart compares it with its pair
+ * of CSRs mtimecmp, 0x34d and 0x35d, which raise its machine timer interrupt.
+ */
+
+#define pr_fmt(fmt) "ftpu-timer: " fmt
+
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/sched_clock.h>
+#include <linux/timex.h>
+
+#include <asm/csr.h>
+
+static unsigned int ftpu_timer_irq;
+
+static u64 notrace ftpu_timer_read(void)
+{
+	return get_cycles64();
+}
+
+static u64 ftpu_clocksource_read(struct clocksource *cs)
+{
+	return get_cycles64();
+}
+
+static struct clocksource ftpu_clocksource = {
+	.name	= "ftpu_clocksource",
+	.rating	= 300,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+	.read	= ftpu_clocksource_read,
+};
+
+/*
+ * The high word of the compare is first set to all ones, so that no value
+ * which the writes of the pair go through is in the past.
+ */
+static void ftpu_timer_set_cmp(u64 cmp)
+{
+	csr_write(CSR_FTPU_MTIMECMPH, ULONG_MAX);
+	csr_write(CSR_FTPU_MTIMECMP, lower_32_bits(cmp));
+	csr_write(CSR_FTPU_MTIMECMPH, upper_32_bits(cmp));
+}
+
+static int ftpu_timer_next_event(unsigned long delta,
+				 struct clock_event_device *ce)
+{
+	ftpu_timer_set_cmp(get_cycles64() + delta);
+	csr_set(CSR_IE, IE_TIE);
+	return 0;
+}
+
+static int ftpu_timer_shutdown(struct clock_event_device *ce)
+{
+	csr_clear(CSR_IE, IE_TIE);
+	ftpu_timer_set_cmp(U64_MAX);
+	return 0;
+}
+
+static DEFINE_PER_CPU(struct clock_event_device, ftpu_clock_event) = {
+	.name			= "ftpu_clockevent",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 100,
+	.set_next_event		= ftpu_timer_next_event,
+	.set_state_shutdown	= ftpu_timer_shutdown,
+};
+
+static irqreturn_t ftpu_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evdev = this_cpu_ptr(&ftpu_clock_event);
+
+	csr_clear(CSR_IE, IE_TIE);
+	evdev->event_handler(evdev);
+	return IRQ_HANDLED;
+}
+
+static int ftpu_timer_starting_cpu(unsigned int cpu)
+{
+	struct clock_event_device *ce = per_cpu_ptr(&ftpu_clock_event, cpu);
+
+	ce->cpumask = cpumask_of(cpu);
+	ce->irq = ftpu_timer_irq;
+	clockevents_config_and_register(ce, riscv_timebase, 100, ULONG_MAX);
+	enable_percpu_irq(ftpu_timer_irq,
+			  irq_get_trigger_type(ftpu_timer_irq));
+	return 0;
+}
+
+static int ftpu_timer_dying_cpu(unsigned int cpu)
+{
+	disable_percpu_irq(ftpu_timer_irq);
+	return 0;
+}
+
+static int __init ftpu_timer_init_dt(struct device_node *np)
+{
+	struct of_phandle_args oirq;
+	int i, n, rc;
+
+	/*
+	 * The machine timer interrupt of each cpu: one mapping serves every
+	 * cpu, the interrupt being per cpu.
+	 */
+	n = of_irq_count(np);
+	for (i = 0; (i < n) && !ftpu_timer_irq; i++) {
+		if (of_irq_parse_one(np, i, &oirq))
+			continue;
+		if (oirq.args_count != 1 || oirq.args[0] != RV_IRQ_TIMER) {
+			pr_err("%pOFP: interrupt %d is not the machine timer\n",
+			       np, i);
+			return -ENODEV;
+		}
+		if (irq_find_host(oirq.np))
+			ftpu_timer_irq = irq_of_parse_and_map(np, i);
+	}
+	if (!ftpu_timer_irq) {
+		pr_err("%pOFP: no machine timer interrupt\n", np);
+		return -ENODEV;
+	}
+
+	pr_info("%pOFP: running at %lu Hz\n", np, riscv_timebase);
+
+	rc = clocksource_register_hz(&ftpu_clocksource, riscv_timebase);
+	if (rc) {
+		pr_err("%pOFP: clocksource register failed [%d]\n", np, rc);
+		return rc;
+	}
+
+	sched_clock_register(ftpu_timer_read, 64, riscv_timebase);
+
+	rc = request_percpu_irq(ftpu_timer_irq, ftpu_timer_interrupt,
+				"ftpu-timer", &ftpu_clock_event);
+	if (rc) {
+		pr_err("%pOFP: registering percpu irq failed [%d]\n", np, rc);
+		return rc;
+	}
+
+	rc = cpuhp_setup_state(CPUHP_AP_FTPU_TIMER_STARTING,
+			       "clockevents/ftpu/timer:starting",
+			       ftpu_timer_starting_cpu, ftpu_timer_dying_cpu);
+	if (rc) {
+		pr_err("%pOFP: cpuhp setup state failed [%d]\n", np, rc);
+		free_percpu_irq(ftpu_timer_irq, &ftpu_clock_event);
+		return rc;
+	}
+
+	return 0;
+}
+
+TIMER_OF_DECLARE(ftpu_timer, "fontamsoc,ftpu-timer", ftpu_timer_init_dt);
diff --git a/include/linux/cpuhotplug.h b/include/linux/cpuhotplug.h
index 22ba327ec..be224b921 100644
--- a/include/linux/cpuhotplug.h
+++ b/include/linux/cpuhotplug.h
@@ -173,6 +173,7 @@ enum cpuhp_state {
 	CPUHP_AP_REALTEK_TIMER_STARTING,
 	CPUHP_AP_RISCV_TIMER_STARTING,
 	CPUHP_AP_CLINT_TIMER_STARTING,
+	CPUHP_AP_FTPU_TIMER_STARTING,
 	CPUHP_AP_CSKY_TIMER_STARTING,
 	CPUHP_AP_TI_GP_TIMER_STARTING,
 	CPUHP_AP_HYPERV_TIMER_STARTING,
