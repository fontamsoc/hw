@@ -51,6 +51,14 @@ bool riscv_ipi_have_virq_range(void);
 /* Set the IPI interrupt numbers for arch (called by irqchip drivers) */
 void riscv_ipi_set_virq_range(int virq, int nr);
 
+#ifdef CONFIG_ARCH_FONTAMSOC
