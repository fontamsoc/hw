diff --git a/arch/riscv/kernel/cpu_ops_spinwait.c b/arch/riscv/kernel/cpu_ops_spinwait.c
index 24869eb88..0a766b843 100644
--- a/arch/riscv/kernel/cpu_ops_spinwait.c
+++ b/arch/riscv/kernel/cpu_ops_spinwait.c
@@ -17,6 +17,10 @@ const struct cpu_operations cpu_ops_spinwait;
 void *__cpu_spinwait_stack_pointer[NR_CPUS] __section(".data");
 void *__cpu_spinwait_task_pointer[NR_CPUS] __section(".data");
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+void (*ftpu_wake_hart)(unsigned long hartid);
+#endif
+
 static void cpu_update_secondary_bootdata(unsigned int cpuid,
 				   struct task_struct *tidle)
 {
@@ -50,6 +54,16 @@ static int spinwait_cpu_start(unsigned int cpuid, struct task_struct *tidle)
 	 */
 	cpu_update_secondary_bootdata(cpuid, tidle);
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+	/*
+	 * The hart, which the bootldr of the FonTamSOC parked, enters the kernel
