+++ b/arch/riscv/include/asm/processor.h
@@ -173,6 +173,11 @@ extern void start_thread(struct pt_regs *regs,
 extern unsigned long __get_wchan(struct task_struct *p);
 
 
+#ifdef CONFIG_ARCH_FONTAMSOC
