 }
 
diff --git a/arch/riscv/kernel/process.c b/arch/riscv/kernel/process.c
index 31a392993..b1dc358d9 100644
--- a/arch/riscv/kernel/process.c
+++ b/arch/riscv/kernel/process.c
@@ -41,10 +41,30 @@ EXPORT_SYMBOL(__stack_chk_guard);
 extern asmlinkage void ret_from_fork_kernel_asm(void);
 extern asmlinkage void ret_from_fork_user_asm(void);
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+/*
+ * The wfi of the FonTamSOC ftpu, in M-mode, waits until an interrupt both
+ * enabled and pending, mstatus.MIE included: arch_cpu_idle(), entered with
+ * interrupts disabled, enables them around its wfi. An interrupt pending
+ * already traps at ftpu_idle_wfi, and do_irq() then moves the epc past it, so
+ * that the idle loop sees what the interrupt did; one which wakes the wfi
+ * traps with the epc past it.
+ */
+void noinstr arch_cpu_idle(void)
+{
+	asm volatile ("	csrsi	" __stringify(CSR_STATUS) ", %0\n"
+		"	.globl	ftpu_idle_wfi\n"
+		"ftpu_idle_wfi:\n"
+		"	wfi\n"
+		"	csrci	" __stringify(CSR_STATUS) ", %0\n"
+		: : "i" (SR_MIE) : "memory");
+}
+#else
 void noinstr arch_cpu_idle(void)
 {
 	cpu_do_idle();
 }
+#endif
 
 int set_unalign_ctl(struct task_struct *tsk, unsigned int val)
 {
diff --git a/arch/riscv/kernel/smpboot.c b/arch/riscv/kernel/smpboot.c
index 601a321e0..5273f08ba 100644
--- a/arch/riscv/kernel/smpboot.c
+++ b/arch/riscv/kernel/smpboot.c
@@ -155,6 +155,35 @@ static void __init of_parse_and_init_cpus(void)
 			cpuid, nr_cpu_ids);
 }
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+/*
+ * On the FonTamSOC ftpu, harts with a data-cache share words between atomic
+ * and plain accesses, as the kernel does, ie: its ticket spinlock, only when
+ * the bitstream is built with ATOMIC_COHERENCE, which the boolean
+ * fontamsoc,atomic-coherence of /cpus states: without it, no secondary hart
+ * is started.
+ */
+static bool __init ftpu_smp_coherent(void)
+{
+	struct device_node *cpus, *np;
+	bool dcache = false, coherent;
+	u32 size;
+
+	for_each_of_cpu_node(np) {
+		if (!of_property_read_u32(np, "d-cache-size", &size) && size)
+			dcache = true;
+	}
+	if (!dcache)
+		return true;
+	cpus = of_find_node_by_path("/cpus");
+	coherent = (cpus && of_property_read_bool(cpus, "fontamsoc,atomic-coherence"));
+	of_node_put(cpus);
+	if (!coherent)
+		pr_warn("ftpu: harts with a data-cache, but no fontamsoc,atomic-coherence in /cpus: running on the boot hart only\n");
+	return coherent;
+}
+#endif
+
 void __init setup_smp(void)
 {
 	int cpuid;
@@ -166,6 +195,11 @@ void __init setup_smp(void)
 	else
 		acpi_parse_and_init_cpus();
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+	if (!ftpu_smp_coherent())
+		return;
+#endif
+
 	for (cpuid = 1; cpuid < nr_cpu_ids; cpuid++)
 		if (cpuid_to_hartid_map(cpuid) != INVALID_HARTID)
 			set_cpu_possible(cpuid, true);
diff --git a/arch/riscv/kernel/time.c b/arch/riscv/kernel/time.c
index ba3477197..7c6344d7c 100644
--- a/arch/riscv/kernel/time.c
+++ b/arch/riscv/kernel/time.c
@@ -24,7 +24,16 @@ void __init time_init(void)
 	acpi_status status;
 	u32 prop;
 
-	if (acpi_disabled) {
+	if (IS_ENABLED(CONFIG_ARCH_FONTAMSOC)) {
+		/*
+		 * The CSR time of the ftpu counts the clock cycles of the
+		 * core, whose frequency its CSR clkfreq gives: the device
+		 * tree carries no frequency.
+		 */
+		riscv_timebase = csr_read(CSR_FTPU_CLKFREQ);
+		pr_info("ftpu: timebase %lu Hz from CSR 0xcc0\n", riscv_timebase);
+		of_clk_init(NULL);
+	} else if (acpi_disabled) {
 		cpu = of_find_node_by_path("/cpus");
 		if (!cpu || of_property_read_u32(cpu, "timebase-frequency", &prop))
 			panic("RISC-V system with no 'timebase-frequency' in DTS\n");
diff --git a/arch/riscv/kernel/traps.c b/arch/riscv/kernel/traps.c
index 47afea4ff..514812adb 100644
--- a/arch/riscv/kernel/traps.c
+++ b/arch/riscv/kernel/traps.c
@@ -396,6 +396,12 @@ asmlinkage void noinstr do_irq(struct pt_regs *regs)
 {
 	irqentry_state_t state = irqentry_enter(regs);
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+	/* The interrupt which arch_cpu_idle() enabled skips its wfi. */
+	if (regs->epc == (unsigned long)ftpu_idle_wfi)
+		regs->epc += 4;
+#endif
+
 	if (IS_ENABLED(CONFIG_IRQ_STACKS) && on_thread_stack())
 		call_on_irq_stack(regs, handle_riscv_irq);
 	else
diff --git a/arch/riscv/mm/cacheflush.c b/arch/riscv/mm/cacheflush.c
index d83a61246..cbefab4e0 100644
--- a/arch/riscv/mm/cacheflush.c
+++ b/arch/riscv/mm/cacheflush.c
@@ -6,10 +6,11 @@
 #include <linux/acpi.h>
 #include <linux/of.h>
 #include <linux/prctl.h>
+#include <linux/sizes.h>
 #include <asm/acpi.h>
 #include <asm/cacheflush.h>
 
-#ifdef CONFIG_SMP
+#if defined(CONFIG_SMP) && !defined(CONFIG_ARCH_FONTAMSOC)
 
 #include <asm/sbi.h>
 
@@ -94,8 +95,137 @@ void flush_icache_mm(struct mm_struct *mm, bool local)
 	preempt_enable();
 }
 
+#endif /* CONFIG_SMP && !CONFIG_ARCH_FONTAMSOC */
+
+#ifdef CONFIG_ARCH_FONTAMSOC
+/*
+ * The words which ftpu_dcache_wb_all() reads, as many as the largest
+ * data-cache holds; never written but by the clearing of the bss, nor
+ * executed: a word of code which a patch wrote would stay dirty when the read
+ * hits it.
+ */
+static u32 ftpu_dcache_evict[SZ_16K / sizeof(u32)];
+
+/*
+ * The size in bytes of the data-cache, from the property d-cache-size of the
+ * cpus of the device tree, null without data-cache; until ftpu_dcache_init()
+ * reads it, or without the property, the largest.
+ */
+static unsigned int ftpu_dcache_size = sizeof(ftpu_dcache_evict);
+
+/*
+ * The largest range which ftpu_dcache_wb() writes back a word at a time: an
+ * amoor.w and the read of ftpu_dcache_wb_all() cost about the same per word,
+ * the latter for every word of the data-cache.
+ */
+#define FTPU_DCACHE_WB_RANGE_MAX	SZ_8K
+
+void ftpu_dcache_wb_range(unsigned long start, unsigned long end)
+{
+	unsigned long p;
+
+	if (!READ_ONCE(ftpu_dcache_size))
+		return;
+	for (p = (start & ~3UL); p < end; p += 4)
+		asm volatile ("amoor.w zero, zero, (%0)" : : "r" (p) : "memory");
+}
+
+void ftpu_dcache_wb_all(void)
+{
+	unsigned int i, n = (READ_ONCE(ftpu_dcache_size) / sizeof(u32));
+
+	for (i = 0; i < n; i++)
+		(void)READ_ONCE(ftpu_dcache_evict[i]);
+}
+
+void ftpu_dcache_wb(unsigned long start, unsigned long end)
+{
+	if ((end - start) <= FTPU_DCACHE_WB_RANGE_MAX)
+		ftpu_dcache_wb_range(start, end);
+	else
+		ftpu_dcache_wb_all();
+}
+
+#ifdef CONFIG_SMP
+/*
+ * The code which a hart wrote may lie dirty in the data-cache of any hart, ie:
+ * an executable read on one hart, flushed on another after a migration; and a
+ * hart may fill its icache ahead from memory, ie: for a predicted return,
+ * between its fence.i and the write-back of another hart: every hart writes
+ * its data-cache back, then every hart invalidates its icache.
+ */
+static void ipi_ftpu_dcache_wb_all(void *info)
+{
+	ftpu_dcache_wb_all();
+}
+
+static void ipi_ftpu_fence_i(void *info)
+{
+	asm volatile ("fence.i" ::: "memory");
+}
+
+void flush_icache_all(void)
+{
+	on_each_cpu(ipi_ftpu_dcache_wb_all, NULL, 1);
+	on_each_cpu(ipi_ftpu_fence_i, NULL, 1);
+}
+EXPORT_SYMBOL(flush_icache_all);
+
+/*
+ * A small range is written back by the amoor.w of ftpu_dcache_wb_range(): with
+ * ATOMIC_COHERENCE, which the kernel requires of harts with a data-cache, an
+ * atomic access first takes its word from every data-cache, writing it back
+ * when dirty.
+ */
+void flush_icache_range(unsigned long start, unsigned long end)
+{
+	if ((end - start) > FTPU_DCACHE_WB_RANGE_MAX) {
+		flush_icache_all();
+		return;
+	}
+	ftpu_dcache_wb_range(start, end);
+	on_each_cpu(ipi_ftpu_fence_i, NULL, 1);
+}
+EXPORT_SYMBOL(flush_icache_range);
+
+void flush_icache_mm(struct mm_struct *mm, bool local)
+{
+	flush_icache_all();
+}
+#else
+void flush_icache_range(unsigned long start, unsigned long end)
+{
+	local_flush_icache_range(start, end);
+}
+EXPORT_SYMBOL(flush_icache_range);
 #endif /* CONFIG_SMP */
 
+static int __init ftpu_dcache_init(void)
+{
+	struct device_node *np;
+	unsigned int size = 0;
+	bool found = false;
+	u32 val;
+
+	for_each_of_cpu_node(np) {
+		if (of_property_read_u32(np, "d-cache-size", &val))
+			continue;
+		found = true;
+		size = max(size, val);
+	}
+	if (!found)
+		return 0;
+	if (size > sizeof(ftpu_dcache_evict)) {
+		pr_warn("ftpu: d-cache-size %u above %zu, which is kept\n",
+			size, sizeof(ftpu_dcache_evict));
+		size = sizeof(ftpu_dcache_evict);
+	}
+	WRITE_ONCE(ftpu_dcache_size, size);
+	return 0;
+}
+early_initcall(ftpu_dcache_init);
+#endif /* CONFIG_ARCH_FONTAMSOC */
+
 #ifdef CONFIG_MMU
 void flush_icache_pte(struct mm_struct *mm, pte_t pte)
 {
