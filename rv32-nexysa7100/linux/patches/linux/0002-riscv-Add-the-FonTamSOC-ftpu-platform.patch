diff --git a/arch/riscv/Kconfig.socs b/arch/riscv/Kconfig.socs
index 848e7149e..b8dbea248 100644
--- a/arch/riscv/Kconfig.socs
+++ b/arch/riscv/Kconfig.socs
@@ -13,6 +13,17 @@ config ARCH_ESWIN
 	  This enables support for ESWIN SoC platform hardware,
 	  including the ESWIN EIC7700 SoC.
 
+config ARCH_FONTAMSOC
+	bool "FonTamSOC (ftpu)"
+	depends on !MMU
+	select FTPU_TIMER
+	select FONTAMSOC_IRQCTRL
+	help
+	  This enables support for the FonTamSOC systems built around the
+	  ftpu RISC-V core, which runs the kernel in machine mode: its timer
+	  and its interrupt controller, and the maintenance of its caches,
+	  whose data-cache instruction fetches do not see.
+
