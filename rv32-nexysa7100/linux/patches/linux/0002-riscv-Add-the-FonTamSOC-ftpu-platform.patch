diff --git a/arch/riscv/include/asm/cacheflush.h b/arch/riscv/include/asm/cacheflush.h
index b1a2ac665..cd04ab601 100644
--- a/arch/riscv/include/asm/cacheflush.h
+++ b/arch/riscv/include/asm/cacheflush.h
@@ -8,6 +8,35 @@
 
 #include <linux/mm.h>
 
+#ifdef CONFIG_ARCH_FONTAMSOC
+/*
+ * The data-cache of the FonTamSOC ftpu is write-back and cannot be flushed as
+ * a whole, while instruction fetches read the memory, fence.i invalidating
+ * the icache only: code which stores wrote is written back first, either by
+ * ftpu_dcache_wb_range(), an amoor.w per word, which writes back a word,
+ * wholly or partly cached, and invalidates its entry, or by
+ * ftpu_dcache_wb_all(), which reads as many words as the data-cache holds
+ * from an array which is never written nor executed, replacing every entry of
+ * the direct-mapped data-cache. ftpu_dcache_wb() does the former for a small
+ * range, the latter otherwise.
+ */
+void ftpu_dcache_wb_range(unsigned long start, unsigned long end);
+void ftpu_dcache_wb_all(void);
+void ftpu_dcache_wb(unsigned long start, unsigned long end);
+
+static inline void local_flush_icache_all(void)
+{
+	ftpu_dcache_wb_all();
+	asm volatile ("fence.i" ::: "memory");
+}
+
+static inline void local_flush_icache_range(unsigned long start,
+					    unsigned long end)
+{
+	ftpu_dcache_wb(start, end);
+	asm volatile ("fence.i" ::: "memory");
+}
+#else
 static inline void local_flush_icache_all(void)
 {
 	asm volatile ("fence.i" ::: "memory");
@@ -18,6 +47,7 @@ static inline void local_flush_icache_range(unsigned long start,
 {
 	local_flush_icache_all();
 }
+#endif /* CONFIG_ARCH_FONTAMSOC */
 
 #define PG_dcache_clean PG_arch_1
 
@@ -81,10 +111,14 @@ void flush_icache_mm(struct mm_struct *mm, bool local);
  * so instead we just flush the whole thing.
  */
 #define flush_icache_range flush_icache_range
+#ifdef CONFIG_ARCH_FONTAMSOC
+void flush_icache_range(unsigned long start, unsigned long end);
+#else
 static inline void flush_icache_range(unsigned long start, unsigned long end)
 {
 	flush_icache_all();
 }
+#endif
 
 extern unsigned int riscv_cbom_block_size;
 extern unsigned int riscv_cboz_block_size;
diff --git a/arch/riscv/include/asm/csr.h b/arch/riscv/include/asm/csr.h
index 4a37a9839..daacbcb2b 100644
--- a/arch/riscv/include/asm/csr.h
+++ b/arch/riscv/include/asm/csr.h
@@ -419,6 +419,15 @@
 #define CSR_MIMPID		0xf13
 #define CSR_MHARTID		0xf14
 
+/*
+ * FonTamSOC ftpu: the machine timer compare is a pair of CSRs, compared with
+ * the CSR time, which counts every clock cycle; the read-only CSR clkfreq
+ * gives the frequency of that clock in Hz.
+ */
+#define CSR_FTPU_MTIMECMP	0x34d
+#define CSR_FTPU_MTIMECMPH	0x35d
+#define CSR_FTPU_CLKFREQ	0xcc0
+
 /* Machine-Level Window to Indirectly Accessed Registers (AIA) */
 #define CSR_MISELECT		0x350
 #define CSR_MIREG		0x351
diff --git a/arch/riscv/include/asm/processor.h b/arch/riscv/include/asm/processor.h
index da5426122..095748c71 100644
