diff --git a/drivers/irqchip/irq-fontamsoc-irqctrl.c b/drivers/irqchip/irq-fontamsoc-irqctrl.c
new file mode 100644
index 000000000..33a1d43f7
--- /dev/null
+++ b/drivers/irqchip/irq-fontamsoc-irqctrl.c
@@ -0,0 +1,308 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// 20261120 (c) William Fonkou Tambe
+/*
+ * The interrupt controller of the FonTamSOC, dev/irqctrl.sv, driven through
+ * hwdrvirqctrl.h: a single word, which every hart shares, takes commands,
+ * each a transaction of two atomic exchanges, hence serialized by a lock with
+ * interrupts disabled.
+ *
+ * The controller dispatches one interrupt at a time, from its sources, to
+ * one of the destinations which it enables, the harts, raising its machine
+ * external interrupt until the hart acknowledges it; the acknowledgment
+ * returns the source, or -1 for an interprocessor interrupt, which reaches a
+ * hart whatever its destination, or -2 when nothing is pending for the hart,
+ * and enables or disables the destination of the hart. The device of the
+ * source disarms itself once acknowledged: its driver arms it again.
+ *
+ * Device interrupts go to the boot hart only: every acknowledgment of
+ * another hart disables its destination. An acknowledgment from an enabled
+ * destination with nothing pending for it is an error which the monitor of
+ * the simulation of the controller reports: the handler acknowledges once per
+ * trap, the level of the interrupt keeping the hart trapping while anything is
+ * pending for it, and the initialization enables the destination of the boot
+ * hart by acknowledging an interprocessor interrupt which it sends that hart;
+ * an acknowledgment from a disabled destination with nothing pending is not
+ * an error, but an interprocessor interrupt would wake a hart which the
+ * bootldr parked. A reset requested through the
+ * controller restarts every hart, cache and device, but neither the memory
+ * nor the calibration of the DDR SDRAM: the bootldr resident at 0x1000 loads
+ * the kernel again.
+ */
+
+#define pr_fmt(fmt) "fontamsoc-irqctrl: " fmt
+
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/processor.h>
+#include <linux/reboot.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+
+#include <soc/fontamsoc/hwdrv.h>
+#include <soc/fontamsoc/hwdrvirqctrl.h>
+
+/* The results of an acknowledgment which are not a source. */
+#define FTPU_IRQCTRL_IPI	((uintptr_t)-1)
+#define FTPU_IRQCTRL_NONE	((uintptr_t)-2)
+
+static DEFINE_RAW_SPINLOCK(ftpu_irqctrl_lock);
+static struct irq_domain *ftpu_irqctrl_domain;
+static unsigned int ftpu_irqctrl_parent_irq;
+static unsigned long ftpu_irqctrl_boot_hart;
+
+/* Acknowledge for hart, enabling its destination only for the boot hart. */
+static uintptr_t ftpu_irqctrl_ack(unsigned long hart)
+{
+	unsigned long flags;
+	uintptr_t r;
+
+	raw_spin_lock_irqsave(&ftpu_irqctrl_lock, flags);
+	r = hwdrvirqctrl_ack(hart, (hart == ftpu_irqctrl_boot_hart));
+	raw_spin_unlock_irqrestore(&ftpu_irqctrl_lock, flags);
+	return r;
+}
+
+/* An interprocessor interrupt to hart. */
+static void ftpu_irqctrl_ipi(unsigned long hart)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&ftpu_irqctrl_lock, flags);
+	hwdrvirqctrl_int(hart);
+	raw_spin_unlock_irqrestore(&ftpu_irqctrl_lock, flags);
+}
+
+#ifdef CONFIG_SMP
+/* The parent of the interprocessor interrupts which ipi_mux multiplexes. */
+static void ftpu_irqctrl_send_ipi(unsigned int cpu)
+{
+	ftpu_irqctrl_ipi(cpuid_to_hartid_map(cpu));
+}
+#endif
+
+static void ftpu_irqctrl_ena(irq_hw_number_t src, uintptr_t en)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&ftpu_irqctrl_lock, flags);
+	hwdrvirqctrl_ena(src, en);
+	raw_spin_unlock_irqrestore(&ftpu_irqctrl_lock, flags);
+}
+
+static void ftpu_irqctrl_mask(struct irq_data *d)
+{
+	ftpu_irqctrl_ena(irqd_to_hwirq(d), 0);
+}
+
+static void ftpu_irqctrl_unmask(struct irq_data *d)
+{
+	ftpu_irqctrl_ena(irqd_to_hwirq(d), 1);
+}
+
+static struct irq_chip ftpu_irqctrl_chip = {
+	.name		= "fontamsoc-irqctrl",
+	.irq_mask	= ftpu_irqctrl_mask,
+	.irq_unmask	= ftpu_irqctrl_unmask,
+	.flags		= IRQCHIP_SKIP_SET_WAKE,
+};
+
+/*
+ * The source is masked at once by disable_irq(), rather than when it next
+ * triggers: the controller then keeps it pending, whereas acknowledging it
+ * while disabled would disarm its device, losing the interrupt.
+ */
+static int ftpu_irqctrl_map(struct irq_domain *d, unsigned int virq,
+			    irq_hw_number_t hwirq)
+{
+	irq_set_chip_and_handler(virq, &ftpu_irqctrl_chip, handle_simple_irq);
+	irq_set_status_flags(virq, IRQ_DISABLE_UNLAZY);
+	return 0;
+}
+
+static const struct irq_domain_ops ftpu_irqctrl_domain_ops = {
+	.map	= ftpu_irqctrl_map,
+	.xlate	= irq_domain_xlate_onecell,
+};
+
+static void ftpu_irqctrl_handle_irq(struct irq_desc *desc)
+{
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+	unsigned long hart = cpuid_to_hartid_map(smp_processor_id());
+	uintptr_t r;
+
+	chained_irq_enter(chip, desc);
+	r = ftpu_irqctrl_ack(hart);
+	if (r == FTPU_IRQCTRL_IPI) {
+#ifdef CONFIG_SMP
+		ipi_mux_process();
+#endif
+	} else if ((r != FTPU_IRQCTRL_NONE) &&
+		   generic_handle_domain_irq(ftpu_irqctrl_domain, r)) {
+		pr_warn_ratelimited("interrupt of source %lu unhandled\n",
+				    (unsigned long)r);
+	}
+	chained_irq_exit(chip, desc);
+}
+
+static int ftpu_irqctrl_starting_cpu(unsigned int cpu)
+{
+	enable_percpu_irq(ftpu_irqctrl_parent_irq,
+			  irq_get_trigger_type(ftpu_irqctrl_parent_irq));
+	return 0;
+}
+
+static int ftpu_irqctrl_dying_cpu(unsigned int cpu)
+{
+	disable_percpu_irq(ftpu_irqctrl_parent_irq);
+	return 0;
+}
+
+/*
+ * Restart: a reset requested through the controller, as hwdrvirqctrl_reset()
+ * requests it; no lock is taken, CMDDEVRDY closing a transaction which another
+ * hart, stopped, left open. Registers ra, a0 and a1 are nulled first, the
+ * reset keeping them: the crt0.S of the bootldr at 0x1000 takes a1 for the end
+ * of its memory when ra is -1 and a0 null.
+ */
+static int ftpu_irqctrl_restart(struct notifier_block *nb, unsigned long mode,
+				void *cmd)
+{
+	local_irq_disable();
+	asm volatile ("	li	ra, 0\n"
+		"	li	a0, 0\n"
+		"	li	a1, 0\n"
+		"1:	amoswap.w.aqrl	zero, zero, (%0)\n"
+		"	amoswap.w.aqrl	t1, %1, (%0)\n"
+		"	andi	t1, t1, 3\n"
+		"	bnez	t1, 1b\n"
+		"2:	wfi\n"
+		"	j	2b\n"
+		: : "r" (IRQCTRLADDR), "r" ((((uintptr_t)-1) << 3) | 0b10)
+		: "ra", "a0", "a1", "t1", "memory");
+	unreachable();
+}
+
+static struct notifier_block ftpu_irqctrl_restart_nb = {
+	.notifier_call	= ftpu_irqctrl_restart,
+	.priority	= 128,
+};
+
+static int __init ftpu_irqctrl_init(struct device_node *node,
+				    struct device_node *parent)
+{
+	struct irq_domain *intc;
+	struct of_phandle_args oirq;
+	unsigned long hart;
+	void __iomem *base;
+	u32 nsources;
+	int i, n, rc;
+
+	/* hwdrvirqctrl.h addresses the controller at 0xf00, by convention. */
+	base = of_iomap(node, 0);
+	if (base != (void __iomem *)IRQCTRLADDR) {
+		pr_err("%pOFP: not at %p\n", node, IRQCTRLADDR);
+		return -ENODEV;
+	}
+
+	if (of_property_read_u32(node, "fontamsoc,nsources", &nsources) ||
+	    !nsources) {
+		pr_err("%pOFP: no fontamsoc,nsources\n", node);
+		return -EINVAL;
+	}
+
+	intc = irq_find_matching_fwnode(riscv_get_intc_hwnode(), DOMAIN_BUS_ANY);
+	if (!intc) {
+		pr_err("%pOFP: no interrupt controller of the cpus\n", node);
+		return -ENODEV;
+	}
+
+	ftpu_irqctrl_boot_hart = cpuid_to_hartid_map(smp_processor_id());
+
+	/*
+	 * Every source disabled; then the destination of each other hart of
+	 * the device tree acknowledged until nothing is pending for it, which
+	 * disables it, and that of the boot hart enabled by acknowledging an
+	 * interprocessor interrupt which it sends itself, its interrupts being
+	 * disabled; a source pending for it reaches the handler.
+	 */
+	for (i = 0; i < nsources; i++)
+		ftpu_irqctrl_ena(i, 0);
+	n = of_irq_count(node);
+	for (i = 0; i < n; i++) {
+		if (of_irq_parse_one(node, i, &oirq) ||
+		    oirq.args_count != 1 || oirq.args[0] != RV_IRQ_EXT ||
+		    riscv_of_parent_hartid(oirq.np, &hart)) {
+			pr_warn("%pOFP: interrupt %d is not the machine external interrupt of a cpu\n",
+				node, i);
+			continue;
+		}
+		if (hart == ftpu_irqctrl_boot_hart)
+			continue;
+		while (ftpu_irqctrl_ack(hart) != FTPU_IRQCTRL_NONE)
+			;
+	}
+	ftpu_irqctrl_ipi(ftpu_irqctrl_boot_hart);
+	if (ftpu_irqctrl_ack(ftpu_irqctrl_boot_hart) != FTPU_IRQCTRL_IPI)
+		pr_warn("%pOFP: the interprocessor interrupt to the boot hart did not come\n",
+			node);
+
+	ftpu_irqctrl_domain = irq_domain_create_linear(of_fwnode_handle(node),
+						       nsources,
+						       &ftpu_irqctrl_domain_ops,
+						       NULL);
+	if (!ftpu_irqctrl_domain) {
+		pr_err("%pOFP: irq domain creation failed\n", node);
+		return -ENOMEM;
+	}
+
+	ftpu_irqctrl_parent_irq = irq_create_mapping(intc, RV_IRQ_EXT);
+	if (!ftpu_irqctrl_parent_irq) {
+		pr_err("%pOFP: no mapping of the external interrupt\n", node);
+		irq_domain_remove(ftpu_irqctrl_domain);
+		return -ENODEV;
+	}
+	irq_set_chained_handler(ftpu_irqctrl_parent_irq, ftpu_irqctrl_handle_irq);
+
+#ifdef CONFIG_SMP
+	/*
+	 * The interprocessor interrupts of the kernel, multiplexed on those of
+	 * the controller; the latter also wake the harts which the bootldr
+	 * parked, from cpu_ops_spinwait.
+	 */
+	rc = ipi_mux_create(BITS_PER_BYTE, ftpu_irqctrl_send_ipi);
+	if (rc <= 0) {
+		pr_err("%pOFP: unable to create muxed IPIs [%d]\n", node, rc);
+		return ((rc < 0) ? rc : -ENODEV);
+	}
+	riscv_ipi_set_virq_range(rc, BITS_PER_BYTE);
+	ftpu_wake_hart = ftpu_irqctrl_ipi;
+#endif
+
+	rc = cpuhp_setup_state(CPUHP_AP_IRQ_FONTAMSOC_STARTING,
+			       "irqchip/fontamsoc/irqctrl:starting",
+			       ftpu_irqctrl_starting_cpu, ftpu_irqctrl_dying_cpu);
+	if (rc) {
+		pr_err("%pOFP: cpuhp setup state failed [%d]\n", node, rc);
+		return rc;
+	}
+
+	rc = register_restart_handler(&ftpu_irqctrl_restart_nb);
+	if (rc)
+		pr_warn("%pOFP: restart handler registration failed [%d]\n",
+			node, rc);
+
+	pr_info("%pOFP: %u sources, boot hart %lu\n", node, nsources,
+		ftpu_irqctrl_boot_hart);
+	return 0;
+}
+
+IRQCHIP_DECLARE(fontamsoc_irqctrl, "fontamsoc,irqctrl", ftpu_irqctrl_init);
