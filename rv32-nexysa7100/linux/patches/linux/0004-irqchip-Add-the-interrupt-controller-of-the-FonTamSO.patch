diff --git a/include/soc/fontamsoc/hwdrv.h b/include/soc/fontamsoc/hwdrv.h
new file mode 100644
index 000000000..305db64d0
--- /dev/null
+++ b/include/soc/fontamsoc/hwdrv.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* 20261120 (c) William Fonkou Tambe */
+/*
+ * The environment which the drivers hwdrv*.h of the FonTamSOC expect from
+ * underLineOS, whose copies, unchanged, are next to this file: _xchg() and
+ * _atomic_op(), as _os.h defines them for 32-bit words, and alignas, a
+ * keyword of C23, which the kernel, built as gnu11, lacks; the drivers give
+ * alignas a type. A driver includes this file first; then it defines
+ * HWDRVCHAR_DATATYPE before including hwdrvchar.h. hwdrvsdsdio.h spells out
+ * the attributes noinline and noclone, which the macro noinline of the kernel
+ * would break: it is to be included with that macro pushed and undefined.
+ */
+
+#ifndef __SOC_FONTAMSOC_HWDRV_H
+#define __SOC_FONTAMSOC_HWDRV_H
+
+#include <linux/build_bug.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+
+#ifndef alignas
+#define alignas(type) __aligned(__alignof__(type))
+#endif
+
+/*
+ * The atomic operation OP, with .aqrl, on the word at PTR: as the drivers
+ * exchange words with a device, ie: on a word of its registers, an atomic
+ * read-write of the bus.
+ */
+#define _atomic_op(OP, PTR, VAL) ({ \
+	__typeof__(PTR) __ptr = (PTR); \
+	__typeof__(VAL) __val = (VAL); \
+	__typeof__(*__ptr) __ret; \
+	__asm__ __volatile__ ( \
+		#OP ".w.aqrl %0, %2, %1\n" \
+		: "=r" (__ret), "+A" (*__ptr) \
+		: "r" (__val) \
+		: "memory"); \
+	__ret; })
+#define _xchg(PTR, VAL) _atomic_op(amoswap, PTR, VAL)
+
+#endif /* __SOC_FONTAMSOC_HWDRV_H */
diff --git a/include/soc/fontamsoc/hwdrvirqctrl.h b/include/soc/fontamsoc/hwdrvirqctrl.h
new file mode 100644
index 000000000..ce7dd0282
--- /dev/null
+++ b/include/soc/fontamsoc/hwdrvirqctrl.h
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// 20260802 (c) William Fonkou Tambe
+
+#ifndef HWDRVIRQCTRL_H
+#define HWDRVIRQCTRL_H
+
+// Commands are sent to the controller writing to it with the
+// following expected format | arg: (WORDBITSZ-2) bits | cmd: 2 bit |
+// where the field "cmd" values are CMDDEVRDY(2'b00), CMDACKIRQ(2'b01),
+// CMDINTDST(2'b10) and CMDENAIRQ(2'b11). The result of a previously
+// sent command is retrieved from the controller reading from it and
+// has the following format
+// | resp: (WORDBITSZ-3) bits | rsvd: 1 bit | cmd: 2 bit |, where the fields
+// "cmd" and "resp" are the command and its result, while the field "rsvd"
+// is reserved and null.
+// Two memory operations, a write followed by a read are needed to send
+// a command to the controller and retrieve its result.
+// The controller has accepted a command only if "cmd" in its result
+// is CMDDEVRDY, otherwise sending the command CMDDEVRDY is needed.
+//
+// The description of commands is as follow:
+// 	CMDDEVRDY: Make the controller accept a new command.
+// 	"resp" in the result gets set to 0.
+// 	CMDACKIRQ: Acknowledges an interrupt source; field "arg" is expected
+// 	to have following format | idx: (WORDBITSZ-3) bits | en: 1 bit |
+// 	where "idx" is the interrupt destination index, "en" enables/disables
+// 	further interrupt delivery to the interrupt destination "idx", except
+// 	for interrupts triggered by CMDINTDST, which "en" does not gate.
+// 	"resp" in the result gets set to -1 for an interrupt triggered by
+// 	CMDINTDST pending for the destination "idx", which gets acknowledged
+// 	ahead of an interrupt from a source routed to "idx", the latter staying
+// 	pending; otherwise "resp" gets set to the interrupt source index, or -2
+// 	if there are no pending interrupts for the destination "idx".
+// 	CMDINTDST: Triggers an interrupt targeting a specific destination,
+// 	held pending for that destination until it acknowledges it;
+// 	field "arg" is expected to have following format
+// 	| idx: (WORDBITSZ-3) bits | rsvd: 1 bit | where "idx" is the interrupt
+// 	destination index to target, "rsvd" is reserved and ignored.
+// 	"resp" in the result gets set to the interrupt destination index
+// 	if valid, or -1 if invalid. The command is never refused: one targeting
+// 	a destination which already has one pending merges with it, a single
+// 	acknowledgement servicing both.
+// 	The destination -1 (all ones) requests a system reset; "resp" in the
+// 	result gets set to -1 as for an invalid destination.
+// 	CMDENAIRQ: Enable/Disable an interrupt source; field "arg" is expected
+// 	to have following format | idx: (WORDBITSZ-3) bits | en: 1 bit |
+// 	where "idx" is the interrupt source index, "en" enables/disables
+// 	interrupts from the interrupt source "idx".
+// 	"resp" in the result gets set to the interrupt source index, or -1
+// 	if invalid.
+//
+// To be multi core proof, an atomic read-write must be used to send
+// a command to the controller until CMDDEVRDY is returned, then another
+// atomic read-write sending CMDDEVRDY must be used to retrieve the
+// result while making the controller ready for the next command.
+//
+// An interrupt from a source must be acknowledged as soon as possible so
+// that the irqctrl can dispatch another interrupt request, as it dispatches
+// them one at a time for all destinations.
+
+#define IRQCTRLADDR ((uintptr_t *)0xf00 /* By convention, the interrupt controller is located at 0xf00 */)
+
+static inline uintptr_t hwdrvirqctrl_ack (uintptr_t idx, uintptr_t en) {
+	uintptr_t irqsrc;
+	do {
+		irqsrc = ((idx<<3) | ((en&1)<<2) | 0b01);
+		irqsrc = _xchg(IRQCTRLADDR, irqsrc);
+	} while (irqsrc & 0b11);
+	irqsrc = 0;
+	irqsrc = _xchg(IRQCTRLADDR, irqsrc);
+	return ((intptr_t)irqsrc >> 3);
+}
+
+static inline uintptr_t hwdrvirqctrl_int (uintptr_t idx) {
+	uintptr_t irqdst;
+	do {
+		irqdst = ((idx<<3) | 0b10);
+		irqdst = _xchg(IRQCTRLADDR, irqdst);
+	} while (irqdst & 0b11);
+	irqdst = 0;
+	irqdst = _xchg(IRQCTRLADDR, irqdst);
+	return ((intptr_t)irqdst >> 3);
+}
+
+static inline uintptr_t hwdrvirqctrl_ena (uintptr_t idx, uintptr_t en) {
+	uintptr_t irqsrc;
+	do {
+		irqsrc = ((idx<<3) | ((en&1)<<2) | 0b11);
+		irqsrc = _xchg(IRQCTRLADDR, irqsrc);
+	} while (irqsrc & 0b11);
+	irqsrc = 0;
+	irqsrc = _xchg(IRQCTRLADDR, irqsrc);
+	return ((intptr_t)irqsrc >> 3);
+}
+
+// Request a system reset, the CMDINTDST destination -1; it never returns.
+// The controller accepts a command only when its previous transaction has
+// been closed: CMDDEVRDY closes whatever transaction another context left
+// open, and the request is accepted exactly when the word it returns has a
+// null "cmd" field, otherwise another context slipped a command in between
+// and the pair is retried; wfi parks the cpu until the reset asserts.
+static inline __attribute__((noreturn)) void hwdrvirqctrl_reset (void) {
+	uintptr_t v;
+	do {
+		(void)_xchg(IRQCTRLADDR, 0);
+		v = _xchg(IRQCTRLADDR, ((((uintptr_t)-1) << 3) | 0b10));
+	} while (v & 0b11);
+	for (;;)
+		__asm__ __volatile__ ("wfi");
+}
+
+#endif /* HWDRVIRQCTRL_H */
