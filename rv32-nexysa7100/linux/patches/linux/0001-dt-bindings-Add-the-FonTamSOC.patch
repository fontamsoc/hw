+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/serial/fontamsoc,serial-uart.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC UART
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The UART of the FonTamSOC: its data word, and its command word, which sets
+  its receive interrupt and its speed, from the frequency of its clock, which
+  it reports.
+
+allOf:
+  - $ref: serial.yaml#
+
+properties:
+  compatible:
+    const: fontamsoc,serial-uart
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    serial@f80 {
+        compatible = "fontamsoc,serial-uart";
+        reg = <0xf80 0x8>;
+        interrupts = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/spi/fontamsoc,spi.yaml b/Documentation/devicetree/bindings/spi/fontamsoc,spi.yaml
