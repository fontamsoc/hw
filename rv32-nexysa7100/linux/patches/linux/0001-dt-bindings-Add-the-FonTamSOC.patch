@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/fontamsoc,spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC SPI master
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The SPI master of the FonTamSOC, mode 0, with one chip select, which
+  transfers words of 4 bytes.
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+properties:
+  compatible:
+    const: fontamsoc,spi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi@e40 {
+        compatible = "fontamsoc,spi";
+        reg = <0xe40 0x8>;
+        interrupts = <3>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        flash@0 {
+            compatible = "jedec,spi-nor";
+            reg = <0>;
+            spi-max-frequency = <50000000>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/timer/fontamsoc,ftpu-timer.yaml b/Documentation/devicetree/bindings/timer/fontamsoc,ftpu-timer.yaml
new file mode 100644
index 000000000..e8394a061
--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/fontamsoc,ftpu-timer.yaml
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/fontamsoc,ftpu-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC ftpu timer
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The timer of the ftpu core, in machine mode: its CSR time, which counts every
+  clock cycle and is the same on every hart, and the pair of CSRs of the
+  machine timer compare of each hart, whose machine timer interrupt it raises.
+  The timebase is the frequency of the clock of the core, which its CSR clkfreq
+  gives.
+
+properties:
+  compatible:
+    const: fontamsoc,ftpu-timer
+
+  interrupts-extended:
+    description: The machine timer interrupt of each hart.
+    minItems: 1
+    maxItems: 16
+
+required:
+  - compatible
+  - interrupts-extended
+
+additionalProperties: false
+
+examples:
+  - |
+    timer {
+        compatible = "fontamsoc,ftpu-timer";
+        interrupts-extended = <&cpu0_intc 7>;
+    };
