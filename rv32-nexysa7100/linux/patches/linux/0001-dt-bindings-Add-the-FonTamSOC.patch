diff --git a/Documentation/devicetree/bindings/interrupt-controller/fontamsoc,irqctrl.yaml b/Documentation/devicetree/bindings/interrupt-controller/fontamsoc,irqctrl.yaml
new file mode 100644
index 000000000..957753322
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/fontamsoc,irqctrl.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/fontamsoc,irqctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC interrupt controller
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The interrupt controller of the FonTamSOC dispatches the interrupts of its
+  sources, one at a time, to the harts of the ftpu core, raising their machine
+  external interrupt until acknowledged, and their interprocessor interrupts.
+  It also resets the system.
+
+properties:
+  compatible:
+    const: fontamsoc,irqctrl
+
+  reg:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 1
+
+  interrupts-extended:
+    description: The machine external interrupt of each hart, a destination.
+    minItems: 1
+    maxItems: 16
+
+  fontamsoc,nsources:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: The count of interrupt sources.
+    minimum: 1
+
+required:
+  - compatible
+  - reg
+  - interrupt-controller
+  - '#interrupt-cells'
+  - interrupts-extended
+  - fontamsoc,nsources
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller@f00 {
+        compatible = "fontamsoc,irqctrl";
+        reg = <0xf00 0x4>;
+        interrupt-controller;
+        #interrupt-cells = <1>;
+        interrupts-extended = <&cpu0_intc 11>;
+        fontamsoc,nsources = <4>;
+    };
diff --git a/Documentation/devicetree/bindings/misc/fontamsoc,dfltdev.yaml b/Documentation/devicetree/bindings/misc/fontamsoc,dfltdev.yaml
new file mode 100644
index 000000000..a1625ef22
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/fontamsoc,dfltdev.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/fontamsoc,dfltdev.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC default device
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The default device of the FonTamSOC acknowledges every access to an address
+  which no device maps, and raises its interrupt; its register, the last word
+  of the address space, holds the first such address since it was read.
+
+properties:
+  compatible:
+    const: fontamsoc,dfltdev
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    dfltdev@fffffffc {
+        compatible = "fontamsoc,dfltdev";
+        reg = <0xfffffffc 0x4>;
+        interrupts = <0>;
+    };
diff --git a/Documentation/devicetree/bindings/mmc/fontamsoc,sdio.yaml b/Documentation/devicetree/bindings/mmc/fontamsoc,sdio.yaml
