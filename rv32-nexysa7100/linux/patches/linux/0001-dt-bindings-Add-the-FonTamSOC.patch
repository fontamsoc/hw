@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/fontamsoc,sdio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FonTamSOC SD host
+
+maintainers:
+  - William Fonkou Tambe <tambewilliam@gmail.com>
+
+description: |
+  The SD host of the FonTamSOC, which drives an SD card in SD mode, 4 bits
+  wide, through two serial interfaces, one for the line CMD and one for the
+  lines DAT; the card is driven as a block device.
+
+properties:
+  compatible:
+    const: fontamsoc,sdio
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    sdsdio@e00 {
+        compatible = "fontamsoc,sdio";
+        reg = <0xe00 0x10>;
+        interrupts = <2>;
+    };
