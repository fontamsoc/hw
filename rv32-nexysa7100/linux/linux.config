# The single-hart kernel of rv32-nexysa7100, from Buildroot's
# board/qemu/riscv32-virt/linux-nommu.config; Buildroot takes it as the
# configuration, the options not listed taking their defaults.
#
# The ISA is rv32ima: the extensions which default to y are disabled. The
# arch Makefile adds _zacas and _zabha to -march when the toolchain has them,
# the kernel using their instructions only after checking the ISA of the DT.
#
# HZ_PERIODIC: plain stores of two harts to the same byte are not coherent on
# the ring of the data-caches when their coherency writes cross; with NO_HZ,
# the cpus write tick_do_timer_cpu, which could leave each believing the
# other keeps jiffies. Only tick_setup_device() writes it with HZ_PERIODIC.
#
# HZ_50, which the patch "time: Add HZ_50" adds, below 100 Hz, the lowest
# choice of the kernel: the caches, of one word per line and direct mapped,
# lose the code and the data of the tick to the program running between two
# ticks, each tick then reading them again from the DDR SDRAM; 50 Hz halves
# that cost, its jiffy of 20 ms keeping the waits of the SD card's driver
# within the 100 ms after which its device aborts a paused transmission.
CONFIG_BLK_DEV_INITRD=y
# CONFIG_MMU is not set
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_ARCH_FONTAMSOC=y
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x41000
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
CONFIG_HZ_PERIODIC=y
CONFIG_HZ_50=y
# CONFIG_JUMP_LABEL is not set
# CONFIG_MODULES is not set
# CONFIG_PERF_EVENTS is not set
CONFIG_BINFMT_FLAT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_VT is not set
CONFIG_SERIAL_FONTAMSOC=y
CONFIG_SERIAL_FONTAMSOC_CONSOLE=y
CONFIG_FONTAMSOC_SDSDIO=y
CONFIG_SPI=y
CONFIG_SPI_FONTAMSOC=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_FONTAMSOC_DFLTDEV=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT2_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
# Defaults which this board does not use: they lengthen the load and the boot.
# EXPERT shows those which only it lets be disabled: VT, INPUT, IO_URING and
# SLUB_DEBUG.
CONFIG_EXPERT=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_INET_DIAG is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_IO_URING is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_SLUB_DEBUG is not set
# No state to suspend to, and PM_SLEEP_SMP would select HOTPLUG_CPU.
# CONFIG_SUSPEND is not set
