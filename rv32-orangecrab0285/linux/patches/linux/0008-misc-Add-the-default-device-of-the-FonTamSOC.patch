index 000000000..69a40cd2c
--- /dev/null
+++ b/drivers/misc/fontamsoc-dfltdev.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// 20261120 (c) William Fonkou Tambe
+/*
+ * The default device of the FonTamSOC, dev/dfltdev.sv: it acknowledges every
+ * access to an address which no device maps, a read returning 0x00000013, a
+ * nop, a write being dropped, and raises its interrupt, until acknowledged.
+ * Its register, the last word of the address space, read-only, holds the
+ * first such address since it was last read: its bits 27 to 2 exact, bit 28
+ * the OR of bits 31 to 28, bits 1 and 0 null. The interrupt is imprecise, and
+ * a fetch which the predictor of the core makes ahead, never executed, raises
+ * it as well: it is reported, never fatal.
+ */
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+static irqreturn_t dfltdev_interrupt(int irq, void *data)
+{
+	void __iomem *reg = (void __iomem __force *)data;
+
+	pr_warn_ratelimited("dfltdev: access to unmapped address %#010x (imprecise, may be a speculative fetch)\n",
+			    readl(reg));
+	return IRQ_HANDLED;
+}
+
+/*
+ * The register is the last word of the address space, which, without MMU, is
+ * also its virtual address: within the range of the error pointers, which
+ * IS_ERR() would take for -4, hence it is mapped without
+ * devm_platform_ioremap_resource().
+ */
+static int dfltdev_probe(struct platform_device *pdev)
+{
+	struct resource *res;
+	void __iomem *reg;
+	int irq;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	if (!devm_request_mem_region(&pdev->dev, res->start, resource_size(res),
+				     dev_name(&pdev->dev)))
+		return -EBUSY;
+	reg = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!reg)
+		return -ENOMEM;
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	/* The address of a fault before the probe, if any, is dropped. */
+	(void)readl(reg);
+	return devm_request_irq(&pdev->dev, irq, dfltdev_interrupt, 0,
+				dev_name(&pdev->dev), (void __force *)reg);
+}
+
+static const struct of_device_id dfltdev_of_match[] = {
+	{ .compatible = "fontamsoc,dfltdev" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, dfltdev_of_match);
+
+static struct platform_driver dfltdev_driver = {
+	.probe	= dfltdev_probe,
+	.driver	= {
+		.name		= "fontamsoc-dfltdev",
+		.of_match_table	= dfltdev_of_match,
+	},
+};
+module_platform_driver(dfltdev_driver);
+
+MODULE_AUTHOR("William Fonkou Tambe");
+MODULE_DESCRIPTION("FonTamSOC default device driver");
+MODULE_LICENSE("GPL");
