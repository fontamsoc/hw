BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_32=y
# BR2_RISCV_USE_MMU is not set
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
# BR2_UCLIBC_INSTALL_UTILS is not set
BR2_TARGET_LDFLAGS="-Wl,-elf2flt=-s32768"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/override.mk"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/patches"
BR2_TARGET_GENERIC_HOSTNAME="orangecrab0285"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.60"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/dts"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ORANGECRAB0285_PATH)/busybox.fragment"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
BR2_PACKAGE_LINUX_SMP=y
