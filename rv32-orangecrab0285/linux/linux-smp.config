# Merged over linux.config for the multi-hart kernel (package linux-smp): the
# bitstream built with CPU_COUNT 1 or 2, and ATOMIC_COHERENCE=1 at 2 harts, the
# secondary hart woken from bootldr by an interprocessor interrupt.
# The spinlocks are ticket spinlocks, the only choice without MMU.
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_RISCV_BOOT_SPINWAIT=y
# CONFIG_HOTPLUG_CPU is not set
